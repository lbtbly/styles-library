# Python env for palette sampling — rebuild with:
#   python3 -m venv .venv && .venv/bin/pip install Pillow
.venv/
__pycache__/
*.pyc

# Derived artifacts, regenerated by scripts/
sources/catalog-review.html
sources/.fetchlist

# macOS
.DS_Store

# NOTE: sources/shots/ IS committed on purpose. The images are immutable —
# filenames are keyed on the Dribbble shot id and never rewritten — so git
# stores each blob once with no history churn. They are the durable provenance
# record behind every style's `sources` array, and validate.py checks they exist.
